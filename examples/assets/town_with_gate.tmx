<?xml version="1.0" encoding="UTF-8"?>
<!-- Authored for examples/doors; edit it in Tiled. See README.md.

     town.tmx with the gate to the garden. Its tile layers are town.tmx's, cell
     for cell, and spec/example_assets_spec.rb holds the two maps to that: an
     edit to one is an edit to both. The rooms of examples/doors build a Door
     from the gate, and the five examples that mount town.tmx define no Door.

     The "doors" object layer holds the gate and the entrances a move arrives
     at. A door draws itself, so the layer changes no tile. -->
<map version="1.10" tiledversion="1.10.2" orientation="orthogonal" renderorder="right-down" width="60" height="40" tilewidth="16" tileheight="16" infinite="0" nextlayerid="4" nextobjectid="5">
 <tileset firstgid="1" source="tileset.tsx"/>
 <layer id="1" name="ground" width="60" height="40">
  <data encoding="base64" compression="zlib"></data>
 </layer>
 <layer id="2" name="obstacles" width="60" height="40">
  <data encoding="base64" compression="zlib"></data>
 </layer>
 <objectgroup id="3" name="doors">
  <object id="1" name="start" type="entrance" x="376" y="262">
   <point/>
  </object>
  <object id="2" name="square" type="entrance" x="456" y="232">
   <point/>
  </object>
  <object id="3" name="gate_out" type="entrance" x="552" y="128">
   <point/>
  </object>
  <object id="4" name="garden_gate" type="Door" x="544" y="80" width="16" height="16">
   <properties>
    <property name="to" value="garden"/>
    <property name="entrance" value="gate_in"/>
   </properties>
  </object>
 </objectgroup>
</map>
