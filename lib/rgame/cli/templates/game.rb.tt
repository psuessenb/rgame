# frozen_string_literal: true

require 'rgame/game'

require_relative '<%= module_file %>'
require_relative 'nodes/root'

module <%= game_module %>
  # The window, its size and its caption, around the tree that starts at Root.
  class Game < RGame::Game
    WIDTH = 640
    HEIGHT = 480

    # Everything this game sets at startup besides its root and its caption.
    # `players: 2` makes it split-screen; RGame::Game::Configuration lists the
    # rest.
    CONFIGURATION = Configuration.new(width: WIDTH, height: HEIGHT,
                                      media_root: File.join(__dir__, 'assets'))

    # A test harness passes `CONFIGURATION.with(input: scripted)` to drive the
    # game with no hardware attached.
    def initialize(configuration: CONFIGURATION)
      super(root: Root.new, caption: '<%= caption %>', configuration:)
    end
  end
end
